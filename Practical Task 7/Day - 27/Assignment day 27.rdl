              <ColumnExpression ColumnOwner="Dataset" ColumnName="Rating" />
              <ColumnExpression ColumnOwner="Dataset" ColumnName="Promoter_Score" />
            </SelectedColumns>
          </QueryDefinition>
        </rd:DesignerState>
        <CommandText>SELECT
  Dataset.Survey_type
  ,Dataset.Brand_Name
  ,Dataset.Customer_Name
  ,Dataset.Gender
  ,Dataset.Response_ID
  ,Dataset.[Month]
  ,Dataset.[Year]
  ,Dataset.Bill_No
  ,Dataset.Age
  ,Dataset.Occupation
  ,Dataset.Order_Id
  ,Dataset.Product
  ,Dataset.Product_Price
  ,Dataset.Mobile_No
  ,Dataset.Location
  ,Dataset.Rating
  ,Dataset.Promoter_Score
FROM
  Dataset</CommandText>
      </Query>

          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Promoter_Score</DataField>
        </Field>
        <Field Name="NewProductPrice">
          <Value>=Fields!ProductPrice.Value * 5</Value>
        </Field>
        <Field Name="SurveyType">
          <Value>=SELECT DISTINCT [SurveyType] FROM dbo.Dataset</Value>
        </Field>
        <Field Name="YearList">
          <Value>SELECT DISTINCT [Year] FROM dbo.Dataset
ORDER BY [Year]</Value>
        </Field>

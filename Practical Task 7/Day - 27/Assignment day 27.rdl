      <Query>
        <DataSourceName>SQL_DS</DataSourceName>
        <rd:DesignerState>
          <QueryDefinition xmlns="http://schemas.microsoft.com/ReportingServices/QueryDefinition/Relational">
            <AutoJoin>False</AutoJoin>
            <SelectedColumns>
              <ColumnExpression ColumnOwner="Dataset" ColumnName="Survey_type" />
              <ColumnExpression ColumnOwner="Dataset" ColumnName="Brand_Name" />
              <ColumnExpression ColumnOwner="Dataset" ColumnName="Customer_Name" />

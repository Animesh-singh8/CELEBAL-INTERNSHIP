  <DataSets>
    <DataSet Name="SurveyMatrixData">
      <Query>
        <DataSourceName>CELEBAL_Day28_Report</DataSourceName>
        <CommandText>EVALUATE
ADDCOLUMNS(
    Customer_Survey_Data,
    "Customer Count", [Customer Count],
    "Average Age", [Average Age],
    "Average Product Price", [Average Product Price]
)</CommandText>
      </Query>
